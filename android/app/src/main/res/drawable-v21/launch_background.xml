<?xml version="1.0" encoding="utf-8"?>
<!--
    Layar peluncuran.

    Ditampilkan Android sebelum Flutter sempat menggambar bingkai pertamanya.
    Sebelumnya putih polos, sehingga pembukaan aplikasi terlihat sebagai kilat
    putih lalu langsung berganti ke latar biru gelap. Warnanya kini disamakan
    dengan latar aplikasi supaya peralihannya tidak terlihat sama sekali.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
